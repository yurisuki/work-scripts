@import "violet-night.rasi"
configuration { show-icons: false; }
window { width: 960px; }
mainbox { padding: 16px; spacing: 10px; children: [inputbar, listview, message]; }
inputbar { padding: 10px 12px; }
entry { placeholder: "Search templates…"; }
listview { lines: 7; spacing: 6px; fixed-height: false; }
element { padding: 11px 14px; spacing: 10px; background-color: @surface; }
element selected.normal { background-color: @selected; }
element-text { vertical-align: 0.5; }
message { padding: 6px 2px 0; }
textbox { font: "Inter 9"; text-color: @muted; }
