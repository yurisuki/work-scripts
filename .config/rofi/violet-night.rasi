configuration {
    modi: "drun,run";
    show-icons: true;
    display-drun: "Applications";
    drun-display-format: "{name}";
    font: "Inter 11";
}
* {
    bg: #171020f2;
    surface: #241a30;
    fg: #ede3f5;
    muted: #b4a3c4;
    accent: #cf5aff;
    background-color: transparent;
    text-color: @fg;
}
window { width: 620px; border: 1px; border-color: #493455; border-radius: 14px; background-color: @bg; }
mainbox { padding: 18px; spacing: 12px; children: [inputbar, message, listview]; }
inputbar { padding: 12px; spacing: 12px; background-color: @surface; border-radius: 8px; children: [prompt, entry]; }
prompt { text-color: @accent; }
entry { placeholder: "Search…"; placeholder-color: @muted; }
listview { lines: 8; columns: 1; spacing: 5px; fixed-height: false; }
element { padding: 11px; spacing: 12px; border-radius: 8px; }
element selected.normal { background-color: #392247; text-color: @accent; }
element-icon { size: 24px; }
element-text { vertical-align: 0.5; }
message { padding: 8px; }
textbox { text-color: @muted; }
