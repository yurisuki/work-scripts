configuration {
    modi: "drun,run";
    show-icons: true;
    display-drun: "Applications";
    drun-display-format: "{name}";
    font: "Inter 11";
}
* {
    bg: #171020f2;
    surface: #241a30;
    fg: #ede3f5;
    muted: #b4a3c4;
    accent: #cf5aff;
    selected: #392247;
    background-color: transparent;
    text-color: @fg;
}
window {
    width: 680px;
    border: 1px;
    border-color: #493455;
    border-radius: 14px;
    background-color: @bg;
}
mainbox { padding: 18px; spacing: 12px; children: [inputbar, listview, message]; }
inputbar {
    padding: 12px;
    spacing: 12px;
    background-color: @surface;
    border-radius: 8px;
    children: [prompt, entry];
}
prompt { text-color: @accent; font: "Inter Semibold 11"; }
entry { placeholder: "Search…"; placeholder-color: @muted; expands: true; }
listview { lines: 8; columns: 1; spacing: 5px; }
element { padding: 10px 12px; spacing: 12px; border-radius: 8px; }
element selected.normal { background-color: @selected; text-color: @accent; }
element-icon { size: 24px; vertical-align: 0.5; }
element-text { vertical-align: 0.5; horizontal-align: 0.0; }
message { padding: 8px 2px 0; }
textbox { font: "Inter 9"; text-color: @muted; }
