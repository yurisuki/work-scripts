[Unit]
Description=Let Hyprland handle the power button
PartOf=graphical-session.target
After=graphical-session.target

[Service]
ExecStart=/usr/bin/systemd-inhibit --what=handle-power-key --who=Hyprland --why=Power-button-opens-session-menu --mode=block /usr/bin/sleep infinity
Restart=on-failure
RestartSec=1

[Install]
WantedBy=graphical-session.target
