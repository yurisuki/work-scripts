# Selected text -> clipboard (both y and Shift+y).
copy y
copy Y

# Fine zoom; original + / - and Ctrl+wheel remain available.
zoom_out ,
zoom_in .
# Match existing Kitty font-size shortcut directions.
zoom_out <C-S-n>
zoom_in <C-S-m>

# Fit quote table width; smart fit ignores white margins.
fit_to_page_width =
fit_to_page_width_smart w
fit_to_page_height W

# Quick page changes and browser-style history.
next_page J
previous_page K
prev_state <A-left>
next_state <A-right>

# Toggle dark mode / original PDF colors.
toggle_dark_mode <f8>

# Optional scrollbar and reload.
toggle_scrollbar <C-b>
reload <C-r>
