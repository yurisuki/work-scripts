{
  "layer": "top",
  "position": "top",
  "height": 43,
  "margin-top": 10,
  "margin-left": 12,
  "margin-right": 12,
  "spacing": 4,
  "modules-left": [
    "custom/launcher",
    "group/workspaces",
    "hyprland/window"
  ],
  "modules-center": [
    "clock",
    "group/music"
  ],
  "modules-right": [
    "tray",
    "custom/ticktick",
    "custom/weather",
    "group/system-status",
    "custom/updates",
    "battery",
    "custom/bluetooth",
    "custom/notification",
    "custom/power"
  ],
  "custom/launcher": {
    "format": "○",
    "tooltip-format": "Violet Night · Applications",
    "on-click": "~/.scripts/hypr-menu.sh apps"
  },
  "custom/capslock": {
    "exec": "~/.scripts/bar-capslock.py",
    "return-type": "json",
    "format": "{text}",
    "restart-interval": 2,
    "exec-on-event": false
  },
  "custom/ticktick": {
    "exec": "~/.scripts/bar-ticktick.py",
    "return-type": "json",
    "format": "{text}",
    "interval": 60,
    "signal": 10,
    "on-click": "kitty -e ~/.local/bin/ttui",
    "escape": false
  },
  "hyprland/window": {
    "format": "{}",
    "max-length": 30,
    "separate-outputs": true
  },
  "clock": {
    "format": "{:L%a  %d %b  ·  %H:%M}",
    "tooltip-format": "<big>{:L%B %Y}</big>\n<tt><small>{calendar}</small></tt>",
    "locale": "cs_CZ.UTF-8",
    "calendar": {
      "format": {
        "today": "<span background='#cf5aff' foreground='#171020'><b>{}</b></span>"
      }
    },
    "on-click": "~/.scripts/bar-calendar.sh"
  },
  "tray": {
    "icon-size": 18,
    "spacing": 10
  },
  "network": {
    "format-wifi": "󰖩",
    "format-ethernet": "󰈀",
    "format-disconnected": "󰖪",
    "tooltip-format": "{ifname} · {ipaddr}",
    "on-click": "hyprctl eval 'open_network()'",
    "max-length": 22
  },
  "pulseaudio": {
    "format": "{icon}  {volume}%",
    "format-muted": "󰝟  Muted",
    "format-icons": {
      "default": [
        "󰕿",
        "󰖀",
        "󰕾"
      ]
    },
    "on-click": "hyprctl eval 'open_audio()'",
    "on-click-right": "~/.scripts/device-notifications.py --volume-mute",
    "on-scroll-up": "~/.scripts/device-notifications.py --volume-up",
    "on-scroll-down": "~/.scripts/device-notifications.py --volume-down",
    "scroll-step": 5
  },
  "custom/brightness": {
    "exec": "~/.scripts/hypr-brightness.sh status",
    "return-type": "json",
    "interval": 30,
    "signal": 8,
    "on-scroll-up": "~/.scripts/hypr-brightness.sh up",
    "on-scroll-down": "~/.scripts/hypr-brightness.sh down",
    "smooth-scrolling-threshold": 1
  },
  "custom/updates": {
    "exec": "~/.scripts/bar-updates.py",
    "return-type": "json",
    "format": "{text}",
    "hide-empty-text": true,
    "interval": 30,
    "on-click": "kitty --hold --title 'work-scripts update' -e ~/.scripts/upd.sh"
  },
  "custom/notification": {
    "exec": "python3 ~/.scripts/bar-notifications.py",
    "return-type": "json",
    "format": "{icon} {text}",
    "format-icons": {
      "focus-on": "󰂛",
      "focus-off": "󰂚",
      "notification": "󱅫",
      "none": "󰂚",
      "dnd-notification": "󰂛",
      "dnd-none": "󰂛",
      "inhibited-notification": "󰂛",
      "inhibited-none": "󰂛",
      "dnd-inhibited-notification": "󰂛",
      "dnd-inhibited-none": "󰂛"
    },
    "on-click": "swaync-client -t -sw",
    "on-click-right": "swaync-client -d -sw",
    "escape": true,
    "restart-interval": 2,
    "exec-on-event": false
  },
  "custom/power": {
    "format": "󰐥",
    "tooltip-format": "Lock · Suspend · Log out · Power",
    "on-click": "~/.scripts/hypr-menu.sh session"
  },
  "group/workspaces": {
    "orientation": "horizontal",
    "modules": [
      "custom/workspace1",
      "custom/workspace2",
      "custom/workspace3",
      "custom/workspace4",
      "custom/workspace5",
      "custom/workspace6",
      "custom/workspace7",
      "custom/workspace8",
      "custom/workspace9",
      "custom/workspace10"
    ]
  },
  "custom/workspace1": {
    "exec": "~/.scripts/hypr-workspace.py status 1",
    "return-type": "json",
    "on-click": "~/.scripts/hypr-workspace.py focus 1",
    "on-scroll-up": "~/.scripts/hypr-workspace.py prev",
    "on-scroll-down": "~/.scripts/hypr-workspace.py next",
    "smooth-scrolling-threshold": 1,
    "signal": 9
  },
  "custom/workspace2": {
    "exec": "~/.scripts/hypr-workspace.py status 2",
    "return-type": "json",
    "on-click": "~/.scripts/hypr-workspace.py focus 2",
    "on-scroll-up": "~/.scripts/hypr-workspace.py prev",
    "on-scroll-down": "~/.scripts/hypr-workspace.py next",
    "smooth-scrolling-threshold": 1,
    "signal": 9
  },
  "custom/workspace3": {
    "exec": "~/.scripts/hypr-workspace.py status 3",
    "return-type": "json",
    "on-click": "~/.scripts/hypr-workspace.py focus 3",
    "on-scroll-up": "~/.scripts/hypr-workspace.py prev",
    "on-scroll-down": "~/.scripts/hypr-workspace.py next",
    "smooth-scrolling-threshold": 1,
    "signal": 9
  },
  "custom/workspace4": {
    "exec": "~/.scripts/hypr-workspace.py status 4",
    "return-type": "json",
    "on-click": "~/.scripts/hypr-workspace.py focus 4",
    "on-scroll-up": "~/.scripts/hypr-workspace.py prev",
    "on-scroll-down": "~/.scripts/hypr-workspace.py next",
    "smooth-scrolling-threshold": 1,
    "signal": 9
  },
  "custom/workspace5": {
    "exec": "~/.scripts/hypr-workspace.py status 5",
    "return-type": "json",
    "on-click": "~/.scripts/hypr-workspace.py focus 5",
    "on-scroll-up": "~/.scripts/hypr-workspace.py prev",
    "on-scroll-down": "~/.scripts/hypr-workspace.py next",
    "smooth-scrolling-threshold": 1,
    "signal": 9
  },
  "battery": {
    "format": "{icon} {capacity}%",
    "format-charging": "󰂄 {capacity}%",
    "format-icons": [
      "󰁺",
      "󰁼",
      "󰁾",
      "󰂀",
      "󰁹"
    ],
    "states": {
      "warning": 25,
      "critical": 10
    },
    "tooltip-format": "{capacity}% · {timeTo}"
  },
  "custom/bluetooth": {
    "exec": "python3 ~/.scripts/bar-bluetooth.py",
    "return-type": "json",
    "format": "{text}",
    "interval": 5,
    "signal": 11,
    "on-click": "hyprctl eval 'open_bluetooth()'"
  },
  "custom/weather": {
    "exec": "~/.scripts/bar-weather.py",
    "return-type": "json",
    "interval": 1800,
    "on-click": "kitty --class weather-popup --title Weather -o font_size=10 -e python3 ~/.scripts/weather-popup.py",
    "on-click-right": "kitty -e nvim ~/.config/waybar/weather.json"
  },
  "custom/workspace6": {
    "exec": "~/.scripts/hypr-workspace.py status 6",
    "return-type": "json",
    "on-click": "~/.scripts/hypr-workspace.py focus 6",
    "on-scroll-up": "~/.scripts/hypr-workspace.py prev",
    "on-scroll-down": "~/.scripts/hypr-workspace.py next",
    "smooth-scrolling-threshold": 1,
    "signal": 9
  },
  "custom/workspace7": {
    "exec": "~/.scripts/hypr-workspace.py status 7",
    "return-type": "json",
    "on-click": "~/.scripts/hypr-workspace.py focus 7",
    "on-scroll-up": "~/.scripts/hypr-workspace.py prev",
    "on-scroll-down": "~/.scripts/hypr-workspace.py next",
    "smooth-scrolling-threshold": 1,
    "signal": 9
  },
  "custom/workspace8": {
    "exec": "~/.scripts/hypr-workspace.py status 8",
    "return-type": "json",
    "on-click": "~/.scripts/hypr-workspace.py focus 8",
    "on-scroll-up": "~/.scripts/hypr-workspace.py prev",
    "on-scroll-down": "~/.scripts/hypr-workspace.py next",
    "smooth-scrolling-threshold": 1,
    "signal": 9
  },
  "custom/workspace9": {
    "exec": "~/.scripts/hypr-workspace.py status 9",
    "return-type": "json",
    "on-click": "~/.scripts/hypr-workspace.py focus 9",
    "on-scroll-up": "~/.scripts/hypr-workspace.py prev",
    "on-scroll-down": "~/.scripts/hypr-workspace.py next",
    "smooth-scrolling-threshold": 1,
    "signal": 9
  },
  "custom/workspace10": {
    "exec": "~/.scripts/hypr-workspace.py status 10",
    "return-type": "json",
    "on-click": "~/.scripts/hypr-workspace.py focus 10",
    "on-scroll-up": "~/.scripts/hypr-workspace.py prev",
    "on-scroll-down": "~/.scripts/hypr-workspace.py next",
    "smooth-scrolling-threshold": 1,
    "signal": 9
  },
  "group/system-status": {
    "orientation": "horizontal",
    "modules": [
      "custom/capslock",
      "network",
      "pulseaudio",
      "custom/brightness"
    ]
  },
  "group/music": {
    "orientation": "horizontal",
    "modules": [
      "custom/music-prev",
      "custom/music",
      "custom/music-next"
    ]
  },
  "custom/music-prev": {
    "exec": "python3 ~/.scripts/bar-music.py watch previous",
    "return-type": "json",
    "format": "{}",
    "restart-interval": 2,
    "exec-on-event": false,
    "on-click": "python3 ~/.scripts/bar-music.py previous"
  },
  "custom/music": {
    "exec": "python3 ~/.scripts/bar-music.py watch title",
    "return-type": "json",
    "format": "{}",
    "restart-interval": 2,
    "exec-on-event": false,
    "on-click": "python3 ~/.scripts/bar-music.py play-pause",
    "max-length": 34
  },
  "custom/music-next": {
    "exec": "python3 ~/.scripts/bar-music.py watch next",
    "return-type": "json",
    "format": "{}",
    "restart-interval": 2,
    "exec-on-event": false,
    "on-click": "python3 ~/.scripts/bar-music.py next"
  }
}
